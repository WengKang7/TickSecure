DirectoryIndex index.php
Options -Indexes

# Local recovery, authenticated demo checkout, blueprint and event poster uploads.
# Generic uploads and other backend actions retain their separate opt-ins.
<IfModule mod_env.c>
    SetEnv TICKSECURE_PHP_PASSWORD_RESET 1
    SetEnv TICKSECURE_PHP_CHECKOUT 1
    SetEnv TICKSECURE_PHP_BLUEPRINT_UPLOAD 1
    SetEnv TICKSECURE_PHP_POSTER_UPLOAD 1
</IfModule>
