rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveProfile() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/Users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.emailVerified == true;
    }

    function isAdmin() {
      return hasActiveProfile()
        && firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEventOwner(eventId) {
      return hasActiveProfile()
        && firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.role == 'organizer'
        && firestore.exists(/databases/(default)/documents/Events/$(eventId))
        && firestore.get(/databases/(default)/documents/Events/$(eventId)).data.organizerUid == request.auth.uid;
    }

    function isSupportedUpload() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image/jpeg|image/png|application/pdf)$');
    }

    function isSupportedImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image/jpeg|image/png)$');
    }

    // Venue blueprints are administrative material.
    match /venues/{venueId}/{fileName} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isSupportedUpload();
      allow delete: if isAdmin();
    }

    // Poster artwork is intentionally public once uploaded. Organizers may
    // upload only to events they own; administrators retain moderation access.
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow create, update: if isSupportedImage() && (isAdmin() || isEventOwner(eventId));
      allow delete: if isAdmin() || isEventOwner(eventId);
    }

    // Complaint evidence is private to the submitter and administrators.
    match /complaints/{userId}/{complaintId}/{fileName} {
      allow read: if isAdmin() || (hasActiveProfile() && request.auth.uid == userId);
      allow create, update: if hasActiveProfile()
        && request.auth.uid == userId
        && isSupportedUpload();
      allow delete: if isAdmin() || (hasActiveProfile() && request.auth.uid == userId);
    }
  }
}
